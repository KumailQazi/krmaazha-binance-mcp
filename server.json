{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.KumailQazi/krmaazha-binance-mcp",
  "title": "Binance (security-first) + crypto analyst",
  "description": "Security-first Binance MCP. 26 tools, human-confirmed spot trades, offline quant research.",
  "version": "1.2.1",
  "websiteUrl": "https://github.com/KumailQazi/krmaazha-binance-mcp",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "krmaazha-binance-mcp",
      "version": "1.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BINANCE_ENV",
          "description": "testnet or mainnet (start with testnet)",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "BINANCE_READ_API_KEY",
          "description": "READ-ONLY Binance API key (the server never holds a trade key)",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "BINANCE_READ_API_SECRET",
          "description": "Secret for the read-only key",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
